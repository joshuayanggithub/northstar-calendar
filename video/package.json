{
  "name": "northstar-video",
  "version": "1.0.0",
  "description": "The README's one-minute walkthrough of northstar (Remotion). Footage: ../scripts/readme/record.mjs.",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/google-fonts": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.535",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render src/index.ts Demo ../docs/media/northstar.mp4 --crf=16 && npm run gif",
    "gif": "ffmpeg -hide_banner -loglevel error -y -i ../docs/media/northstar.mp4 -vf \"fps=10,scale=960:-1:flags=lanczos,split[s0][s1];[s0]palettegen=max_colors=128:stats_mode=diff[p];[s1][p]paletteuse=dither=bayer:bayer_scale=4:diff_mode=rectangle\" ../docs/media/northstar.gif",
    "record": "cd .. && PLAYWRIGHT_BROWSERS_PATH=0 node scripts/readme/record.mjs"
  }
}
